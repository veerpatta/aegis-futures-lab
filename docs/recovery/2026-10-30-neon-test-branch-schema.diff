 --
+-- Name: admin_control_guard(); Type: FUNCTION; Schema: public; Owner: neondb_owner
+--
+
+CREATE FUNCTION public.admin_control_guard() RETURNS trigger
+    LANGUAGE plpgsql
+    AS $$
+BEGIN
+  IF TG_OP = 'DELETE' THEN RAISE EXCEPTION 'Admin commands cannot be deleted'; END IF;
+  IF OLD.status <> 'pending' OR NEW.status NOT IN ('applied','failed')
+    OR OLD.id IS DISTINCT FROM NEW.id OR OLD.owner_id IS DISTINCT FROM NEW.owner_id
+    OR OLD.action IS DISTINCT FROM NEW.action OR OLD.reason IS DISTINCT FROM NEW.reason
+    OR OLD.expected_experiment_id IS DISTINCT FROM NEW.expected_experiment_id OR OLD.created_at IS DISTINCT FROM NEW.created_at
+    OR NEW.completed_at IS NULL OR NEW.result IS NULL THEN
+    RAISE EXCEPTION 'Admin commands may only be completed once';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+
+ALTER FUNCTION public.admin_control_guard() OWNER TO neondb_owner;
+
