+
+CREATE TABLE public.admin_control_commands (
+    id text NOT NULL,
+    owner_id text NOT NULL,
+    action text NOT NULL,
+    reason text NOT NULL,
+    expected_experiment_id text,
+    status text DEFAULT 'pending'::text NOT NULL,
+    created_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
+    completed_at timestamp with time zone,
+    result text,
+    CONSTRAINT admin_control_commands_action_check CHECK ((action = ANY (ARRAY['pause'::text, 'resume'::text, 'stop'::text, 'start'::text]))),
+    CONSTRAINT admin_control_commands_check CHECK ((((status = 'pending'::text) AND (completed_at IS NULL) AND (result IS NULL)) OR ((status = ANY (ARRAY['applied'::text, 'failed'::text])) AND (completed_at IS NOT NULL) AND (result IS NOT NULL)))),
+    CONSTRAINT admin_control_commands_expected_experiment_id_check CHECK (((expected_experiment_id IS NULL) OR ((length(expected_experiment_id) >= 1) AND (length(expected_experiment_id) <= 128)))),
+    CONSTRAINT admin_control_commands_id_check CHECK ((id ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'::text)),
+    CONSTRAINT admin_control_commands_owner_id_check CHECK ((owner_id = 'REDACTED_OWNER_ID'::text)),
+    CONSTRAINT admin_control_commands_reason_check CHECK (((length(btrim(reason)) >= 8) AND (length(btrim(reason)) <= 500))),
+    CONSTRAINT admin_control_commands_result_check CHECK (((result IS NULL) OR ((length(result) >= 1) AND (length(result) <= 500)))),
+    CONSTRAINT admin_control_commands_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'applied'::text, 'failed'::text])))
+);
+
+
+ALTER TABLE public.admin_control_commands OWNER TO neondb_owner;
