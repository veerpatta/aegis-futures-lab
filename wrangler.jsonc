// Cloudflare Workers config (OpenNext). `npm run cf:deploy` builds .open-next/ and uploads it.
// Secrets (AI_DATABASE_URL, DATABASE_URL, AI_SHADOW_CRON_SECRET, the NVIDIA key, OPENAI_API_SECRET, ...)
// are set with `wrangler secret put <NAME>` or synced from the VPPS vault — never written here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegis-futures-lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aegis-futures-lab"
    }
  ],
  // Run the Worker close to the Neon database instead of next to each visitor.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
